{
    "name": "student-activity-management-backend",
    "version": "1.0.0",
    "description": "Backend website đăng ký và quản lý hoạt động phục vụ cộng đồng của sinh viên",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "check": "node --check server.js && node --check src/app.js",
