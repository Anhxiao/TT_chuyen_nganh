        "jsonwebtoken": "^9.0.2",
        "mssql": "^12.7.13",
        "mysql2": "^3.14.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "nodemon": "^3.1.10"
    }
